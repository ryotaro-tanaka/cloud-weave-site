---
import Layout from '~/layouts/PageLayout.astro';

import { getAsset } from '~/utils/permalinks';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Cloud Weave | Download for Windows',
  ignoreTitleTemplate: true,
  description:
    'Bring multiple cloud drives into one Windows workspace. Free open beta download, known limitations, and feedback.',
  // TODO: Set canonical URL when production URL is fixed
};
---

<Layout metadata={metadata}>
  <Hero
    id="hero"
    actions={[
      {
        variant: 'primary',
        text: 'Download',
        href: 'https://github.com/ryotaro-tanaka/cloud-weave-site/releases/download/v0.3.1/cloud-weave_0.3.1_x64-setup.exe',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">Multiple clouds, one screen—<br />without losing track of where files live.</Fragment>
    <Fragment slot="subtitle">
      Free open beta for Windows. Work across multiple cloud storage accounts in a single workspace.
    </Fragment>
    <Fragment slot="content">
      <div class="text-sm text-muted mt-4 dark:text-slate-400">
        Run the downloaded installer. Windows 10 or later, 64-bit.
      </div>
    </Fragment>
    <Fragment slot="image">
      <img
        src={getAsset('/images/Screenshot.png')}
        alt="Cloud Weave main window"
        class="mx-auto w-full max-w-5xl rounded-lg shadow-lg"
      />
    </Fragment>
  </Hero>

  <Content
    id="why-cloud-weave"
    title="Why Cloud Weave"
    columns={1}
    items={[
      {
        title: 'One screen for every cloud',
        description: 'Stop juggling separate apps or browser tabs—work from a single view.',
      },
      {
        title: 'Find files by intent, not path',
        description: 'Jump to Recent, Documents, Photos, and more—without walking the folder tree every time.',
      },
      {
        title: 'Always know where things are',
        description: 'Even in a unified view, you can see which account and location a file belongs to.',
      },
      {
        title: 'Free to use',
        description:
          "The app is free—there's no paid tier. It's built so you can use the free space you already have across providers without picking a folder for every upload.",
      },
    ]}
  >
    <Fragment slot="content">
      Cloud Weave goes beyond treating clouds as separate folders—it connects how you search, organize, and place files.
    </Fragment>
  </Content>

  <WidgetWrapper id="known-limitations" containerClass="max-w-5xl">
    <Headline
      title="Known Limitations"
      subtitle="This is an open beta—features and the UI may change as we ship updates.<br /><br />Some settings might not carry over to future releases."
    />
  </WidgetWrapper>

  <WidgetWrapper id="feedback" containerClass="max-w-5xl">
    <Headline
      title="Feedback"
      subtitle="Found a bug or have an idea? Send it through the form below.<br /><br />If you can, attach the diagnostic ZIP exported from the app—it makes investigations much easier."
    />
    <div class="flex justify-center">
      <Button
        variant="secondary"
        text="Open feedback form"
        href="https://usebasin.com/form/37c12519bb6c/hosted/46b7f138fca3"
        target="_blank"
        icon="tabler:message"
      />
    </div>
  </WidgetWrapper>

  <WidgetWrapper id="support-development" containerClass="max-w-5xl">
    <Headline
      title="Support the project"
      subtitle="If Cloud Weave is useful to you, a small tip on Ko-fi goes a long way."
    />
    <div class="flex justify-center">
      <script is:inline type="text/javascript" src="https://storage.ko-fi.com/cdn/widget/Widget_2.js"></script>
      <script is:inline type="text/javascript">
        kofiwidget2.init('Support me on Ko-fi', '#72a4f2', 'T6T51X3Q4V');
        kofiwidget2.draw();
      </script>
    </div>
  </WidgetWrapper>
</Layout>
